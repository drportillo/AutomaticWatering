// Go to https://app.arduino.cc, open your Thing, and download the full sketch —
// thingProperties.h will be inside it. Copy it here and remove this comment.
//
// The file must declare the variables and callbacks below and register them
// with ArduinoCloud inside initProperties().

#include <ArduinoIoTCloud.h>
#include <Arduino_ConnectionHandler.h>

#include "passwords.h"

// Cloud variables — must match the names configured in the Arduino IoT Cloud dashboard.
String ac_t;       // temperature readings (all 3 zones, space-separated)
String ac_h;       // humidity readings   (all 3 zones, space-separated)
bool   ac_pump1;
bool   ac_pump2;
bool   ac_pump3;

// Forward-declare the callbacks defined in main.cpp.
void onAcPump1Change();
void onAcPump2Change();
void onAcPump3Change();

WiFiConnectionHandler ArduinoIoTPreferredConnection(SECRET_SSID, SECRET_PASS);

void initProperties() {
    ArduinoCloud.setBoardId("your-device-id");
    ArduinoCloud.setSecretDeviceKey("your-secret-key");

    ArduinoCloud.addProperty(ac_t,     READ,  ON_CHANGE);
    ArduinoCloud.addProperty(ac_h,     READ,  ON_CHANGE);
    ArduinoCloud.addProperty(ac_pump1, READWRITE, ON_CHANGE, onAcPump1Change);
    ArduinoCloud.addProperty(ac_pump2, READWRITE, ON_CHANGE, onAcPump2Change);
    ArduinoCloud.addProperty(ac_pump3, READWRITE, ON_CHANGE, onAcPump3Change);
}
